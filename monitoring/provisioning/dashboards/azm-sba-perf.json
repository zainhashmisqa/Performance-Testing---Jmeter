{
  "description": "AZM SBA Academy — JMeter Performance Dashboard (k6-inspired)",
  "editable": true,
  "graphTooltip": 2,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Overview — $application",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Virtual Users",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 1 },
      "datasource": "InfluxDB",
      "targets": [
        {
          "query": "SELECT last(\"maxAT\") AS \"max\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'internal') AND $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true, "refId": "A"
        },
        {
          "query": "SELECT last(\"meanAT\") AS \"mean\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'internal') AND $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true, "refId": "B"
        },
        {
          "query": "SELECT last(\"minAT\") AS \"min\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'internal') AND $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true, "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30, "lineWidth": 2, "spanNulls": true, "gradientMode": "opacity", "showPoints": "never", "stacking": { "mode": "none" } },
          "unit": "short", "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "mean" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "min" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["min", "max"] } }
    },
    {
      "title": "Requests per Second",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 1 },
      "datasource": "InfluxDB",
      "targets": [
        {
          "query": "SELECT last(\"hit\") AS \"total\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true, "refId": "A"
        },
        {
          "query": "SELECT last(\"avg\") AS \"avg\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true, "refId": "B", "hide": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": { "fillOpacity": 40, "lineWidth": 2, "spanNulls": true, "gradientMode": "opacity", "showPoints": "never" },
          "unit": "reqps", "min": 0
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["max", "mean"] } }
    },
    {
      "title": "Errors per Second",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 1 },
      "datasource": "InfluxDB",
      "targets": [
        {
          "query": "SELECT non_negative_derivative(sum(\"countError\"), 1s) AS \"errors/s\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true, "refId": "A"
        },
        {
          "query": "SELECT sum(\"countError\") AS \"total errors\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true, "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 30, "lineWidth": 2, "spanNulls": true, "gradientMode": "opacity", "showPoints": "never" },
          "unit": "short", "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "errors/s" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "total errors" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] } }
    },
    {
      "title": "Checks per Second",
      "description": "Passed vs total assertion checks",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 1 },
      "datasource": "InfluxDB",
      "targets": [
        {
          "query": "SELECT sum(\"count\") AS \"total\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true, "refId": "total"
        },
        {
          "query": "SELECT sum(\"count\") AS \"passed\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"statut\" = 'ok') AND $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true, "refId": "ok"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 30, "lineWidth": 2, "spanNulls": true, "gradientMode": "opacity", "showPoints": "never" },
          "unit": "short", "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "ok" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byFrameRefID", "options": "total" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] } }
    },

    {
      "title": "Response Time — $application",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "collapsed": false
    },
    {
      "title": "Avg Response (mean)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 9 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT mean(\"avg\") AS \"Mean\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 2000 }] }
        }
      },
      "options": { "colorMode": "value", "textMode": "auto", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Max Response",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 9 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT max(\"max\") AS \"Max\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 3000 }] }
        }
      },
      "options": { "colorMode": "value", "textMode": "auto", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Min Response",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 9 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT min(\"min\") AS \"Min\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "colorMode": "value", "textMode": "auto", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "p90",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 9 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT mean(\"pct90.0\") AS \"p90\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 3000 }] }
        }
      },
      "options": { "colorMode": "value", "textMode": "auto", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "p95",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 9 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT mean(\"pct95.0\") AS \"p95\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1500 }, { "color": "red", "value": 3000 }] }
        }
      },
      "options": { "colorMode": "value", "textMode": "auto", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "p99",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 9 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT mean(\"pct99.0\") AS \"p99\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 2000 }, { "color": "red", "value": 4000 }] }
        }
      },
      "options": { "colorMode": "value", "textMode": "auto", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "title": "Response Time (over time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "InfluxDB",
      "targets": [
        {
          "query": "SELECT last(\"max\") AS \"max\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true, "refId": "max"
        },
        {
          "query": "SELECT last(\"pct95.0\") AS \"p95\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true, "refId": "p95"
        },
        {
          "query": "SELECT last(\"pct90.0\") AS \"p90\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true, "refId": "p90"
        },
        {
          "query": "SELECT last(\"avg\") AS \"avg\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true, "refId": "avg"
        },
        {
          "query": "SELECT last(\"min\") AS \"min\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true, "refId": "min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": true, "showPoints": "never", "gradientMode": "scheme" },
          "unit": "ms", "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }, { "id": "custom.fillOpacity", "value": 25 }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "p90" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "avg" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "min" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "title": "Response Time — Per Transaction",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT last(\"avg\") FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"statut\" = 'all') AND (\"transaction\" != 'all') AND (\"transaction\" != 'internal') AND $timeFilter GROUP BY time($__interval), \"transaction\"",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 0, "lineWidth": 2, "spanNulls": true, "pointSize": 5, "showPoints": "always" },
          "unit": "ms",
          "displayName": "${__field.labels.transaction}"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "title": "Test Results — $application",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false
    },
    {
      "title": "Total Samples",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 21 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT sum(\"count\") AS \"Total\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "textMode": "value", "graphMode": "none" }
    },
    {
      "title": "Passed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 21 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT sum(\"count\") AS \"Passed\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"statut\" = 'ok') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "textMode": "value", "graphMode": "none" }
    },
    {
      "title": "Failed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 21 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT sum(\"count\") AS \"Failed\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"statut\" = 'ko') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": { "steps": [{ "color": "red", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "textMode": "value", "graphMode": "none" }
    },
    {
      "title": "Error Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 21 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT sum(\"countError\") / sum(\"count\") * 100 AS \"Error %\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100, "unit": "percent", "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]}
        }
      }
    },
    {
      "title": "Peak VUs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 21 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT max(\"maxAT\") AS \"Peak\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'internal') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": { "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "textMode": "value", "graphMode": "none" }
    },
    {
      "title": "Data Sent",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 21 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT sum(\"sb\") AS \"Sent\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes", "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "super-light-blue" },
          "thresholds": { "steps": [{ "color": "super-light-blue", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "textMode": "value", "graphMode": "none" }
    },
    {
      "title": "Data Received",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 21 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT sum(\"rb\") AS \"Received\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes", "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "super-light-green" },
          "thresholds": { "steps": [{ "color": "super-light-green", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "textMode": "value", "graphMode": "none" }
    },
    {
      "title": "Avg Response",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 21 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT last(\"avg\") AS \"Avg\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"transaction\" = 'all') AND (\"statut\" = 'all') AND $timeFilter",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 500 },
            { "color": "red", "value": 2000 }
          ]}
        }
      },
      "options": { "colorMode": "background", "textMode": "value", "graphMode": "area" }
    },

    {
      "title": "Weighted Mix Breakdown",
      "description": "Browse=50% / Explore=30% / Deep Dive=20%",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 25 },
      "datasource": "InfluxDB",
      "targets": [{
        "query": "SELECT sum(\"count\") FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"statut\" = 'all') AND (\"transaction\" =~ /^TX-.*/) AND $timeFilter GROUP BY \"transaction\"",
        "rawQuery": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "displayName": "${__field.labels.transaction}"
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      }
    },
    {
      "title": "Pass vs Fail — Per Request",
      "description": "S00=Login → TX-01=Browse → TX-02=Explore → TX-03=Deep Dive",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 25 },
      "datasource": "InfluxDB",
      "targets": [
        {
          "query": "SELECT sum(\"count\") AS \"Passed\" FROM \"jmeter\" WHERE (\"application\" =~ /^$application$/) AND (\"statut\" = 'ok') AND (\"transaction\" != 'all') AND (\"transaction\" != 'internal') AND $timeFilter GROUP BY \"transaction\"",
          "rawQuery": true, "refId": "pass"
        },
        {
