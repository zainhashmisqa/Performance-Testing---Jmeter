              </hashTree>

              <!-- === S01d Course Catalog — CONCEPT 4: filtered by the categorySlug
                   extracted from S01c. This is the search step of the
                   categories -> search -> detail chain. === -->
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S01d Course Catalog (filtered by category)" enabled="true">
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
                  <collectionProp name="Arguments.arguments"/>
