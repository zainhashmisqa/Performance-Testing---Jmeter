                </collectionProp>
                <stringProp name="Assertion.custom_message">My-courses returned non-200 in deep dive</stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <intProp name="Assertion.test_type">8</intProp>
              </ResponseAssertion>
              <hashTree/>
            </hashTree>

            <!-- CONCEPT 4 (deck 4) — the userId captured at login is carried into the
                 profile lookup, so this request is addressed by an upstream value
                 rather than the generic /me/ alias. -->
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S06 User profile (deep dive, chained by userId)" enabled="true">
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
