            <hashTree>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CONCEPT 2 (deck 2) — JSON Extractor: fullName" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">fullName</stringProp>
