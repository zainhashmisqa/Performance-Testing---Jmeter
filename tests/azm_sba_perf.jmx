              <!-- =================================================================
                   CONCEPT 4 (deck 4) — REQUEST CHAINING: course detail.

                   This sits INSIDE the catalog branch, immediately after the search
                   that produces its input. Placing it outside would run it even on
                   iterations where the search never executed, so it would request
                   /courses/NO_SLUG/ and fail for a reason the target is not
                   responsible for. A chained request belongs with its producer.
                   ================================================================= -->
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S01e Course Detail (chained from catalog)" enabled="true">
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
                  <collectionProp name="Arguments.arguments"/>
                </elementProp>
                <stringProp name="HTTPSampler.method">GET</stringProp>
                <stringProp name="HTTPSampler.path">${__P(path_courses_base,/api/catalog/courses/)}${catalogCourseSlug}/</stringProp>
              </HTTPSamplerProxy>
              <hashTree>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CONCEPT 2 (deck 2) — JSON Extractor: detailCourseId" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">detailCourseId</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.id</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
