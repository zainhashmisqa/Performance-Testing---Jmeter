              </HTTPSamplerProxy>
              <hashTree>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CONCEPT 2 (deck 2) — JSON Extractor: categorySlug" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">categorySlug</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$[*].slug</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">0</stringProp>
                  <stringProp name="JSONPostProcessor.defaultValues">NO_CATEGORY</stringProp>
