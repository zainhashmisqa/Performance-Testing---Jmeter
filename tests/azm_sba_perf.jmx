<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="AZM SBA Academy — Performance Test Plan (17 concepts)" enabled="true">
      <stringProp name="TestPlan.comments">CONCEPT 5 (deck 5) Profiling &amp; Analysis: the TX-01/TX-02/TX-03 Transaction Controllers produce per-step p90/p95/p99 in the generated HTML report; scripts/check_sla.py grades them. AZM QA performance assignment. All 17 concepts. Property-driven: nothing is hardcoded. Run headless: jmeter -n -t tests/azm_sba_perf.jmx -q config/user.properties -l results/run.jtl -e -o results/html</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="UDV — resolved from properties (CONCEPT 14)" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="env" elementType="Argument">
            <stringProp name="Argument.name">env</stringProp>
            <stringProp name="Argument.value">${__P(env,staging)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="tokenJsonPath" elementType="Argument">
            <stringProp name="Argument.name">tokenJsonPath</stringProp>
            <stringProp name="Argument.value">${__P(token_json_path,$.token)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <!-- =================================================================
           CONFIG ELEMENTS
           ================================================================= -->

      <!-- =================================================================
           CONCEPT 2/4 — correlation variable defaults.

           An extractor that never runs leaves its variable UNDEFINED, and JMeter
           then substitutes the literal text "${name}" into the URL. The braces
           are illegal in a URI, so the sampler dies with URISyntaxException
           instead of making a request - a failure that looks like a target
           problem but is purely a scripting one.

           Seeding every correlated variable here guarantees a chained request is
           always syntactically valid. A value that is still the seed at request
           time means the capture did not happen, which the assertions then
           report honestly as a business failure rather than a transport error.
           ================================================================= -->
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="CONCEPT 2 (deck 2) — Correlation variable defaults" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="catalogCourseSlug" elementType="Argument">
            <stringProp name="Argument.name">catalogCourseSlug</stringProp>
            <stringProp name="Argument.value">NO_SLUG</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="catalogCourseId" elementType="Argument">
            <stringProp name="Argument.name">catalogCourseId</stringProp>
            <stringProp name="Argument.value">NO_CATALOG_ID</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="categorySlug" elementType="Argument">
            <stringProp name="Argument.name">categorySlug</stringProp>
            <stringProp name="Argument.value">NO_CATEGORY</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="categoryId" elementType="Argument">
            <stringProp name="Argument.name">categoryId</stringProp>
            <stringProp name="Argument.value">NO_CAT_ID</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="courseSlug" elementType="Argument">
            <stringProp name="Argument.name">courseSlug</stringProp>
            <stringProp name="Argument.value">NO_COURSE</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="certId" elementType="Argument">
            <stringProp name="Argument.name">certId</stringProp>
            <stringProp name="Argument.value">NO_CERT</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="enrollmentId" elementType="Argument">
            <stringProp name="Argument.name">enrollmentId</stringProp>
            <stringProp name="Argument.value">NO_ENROLLMENT</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="userId" elementType="Argument">
            <stringProp name="Argument.name">userId</stringProp>
            <stringProp name="Argument.value">NO_USER</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="detailCourseId" elementType="Argument">
            <stringProp name="Argument.name">detailCourseId</stringProp>
            <stringProp name="Argument.value">NO_DETAIL_ID</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="authToken" elementType="Argument">
            <stringProp name="Argument.name">authToken</stringProp>
            <stringProp name="Argument.value">NOT_FOUND</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>

      <!-- CONCEPT 3 (deck 3) — Parameterization -->
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CONCEPT 3 (deck 3) — CSV Data Set (120 synthetic logins)" enabled="true">
        <stringProp name="filename">${__P(csvfile,data/logins.csv)}</stringProp>
        <stringProp name="fileEncoding">UTF-8</stringProp>
        <stringProp name="variableNames"></stringProp>
        <boolProp name="ignoreFirstLine">false</boolProp>
        <stringProp name="delimiter">,</stringProp>
        <boolProp name="quotedData">false</boolProp>
        <boolProp name="recycle">true</boolProp>
        <boolProp name="stopThread">false</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
      </CSVDataSet>
      <hashTree/>

      <!-- CONCEPT 14 (deck 15) — Config Management: host/port/protocol all from properties -->
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="CONCEPT 14 (deck 15) — HTTP Request Defaults (property-driven)" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${__P(base_url,localhost)}</stringProp>
        <stringProp name="HTTPSampler.port">${__P(port,443)}</stringProp>
        <stringProp name="HTTPSampler.protocol">${__P(protocol,https)}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.path"></stringProp>
        <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
        <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
      </ConfigTestElement>
      <hashTree/>

      <!-- CONCEPT 10 (deck 7) — Dynamic Auth Headers: token comes from correlation, never a literal -->
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="CONCEPT 10 (deck 7) — HTTP Header Manager (Token ${authToken})" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Authorization</stringProp>
            <stringProp name="Header.value">Token ${authToken}</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">X-Test-Run</stringProp>
            <stringProp name="Header.value">azm-jmeter-${__P(env,staging)}</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>

      <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="HTTP Cookie Manager (per-thread session isolation)" enabled="true">
        <collectionProp name="CookieManager.cookies"/>
        <boolProp name="CookieManager.clearEachIteration">false</boolProp>
        <boolProp name="CookieManager.controlledByThreadGroup">false</boolProp>
      </CookieManager>
      <hashTree/>

      <CacheManager guiclass="CacheManagerGui" testclass="CacheManager" testname="HTTP Cache Manager" enabled="true">
        <boolProp name="clearEachIteration">true</boolProp>
        <boolProp name="useExpires">true</boolProp>
        <stringProp name="maxSize">5000</stringProp>
      </CacheManager>
      <hashTree/>

      <!-- CONCEPT 11 (deck 8) — JDBC Connection Config (driver/URL are properties) -->
      <JDBCDataSource guiclass="TestBeanGUI" testclass="JDBCDataSource" testname="CONCEPT 11 (deck 8) — JDBC Connection Config (pool: azmPool)" enabled="true">
        <stringProp name="dataSource">${__P(db_pool,azmPool)}</stringProp>
        <stringProp name="driver">${__P(db_driver,com.mysql.cj.jdbc.Driver)}</stringProp>
        <stringProp name="dbUrl">${__P(db_url,jdbc:mysql://localhost:3306/edxapp)}</stringProp>
        <stringProp name="username">${__P(db_user,)}</stringProp>
        <stringProp name="password">${__P(db_password,)}</stringProp>
        <stringProp name="poolMax">${__P(db_max_connections,10)}</stringProp>
        <stringProp name="timeout">10000</stringProp>
        <stringProp name="trimInterval">60000</stringProp>
        <boolProp name="autocommit">true</boolProp>
        <boolProp name="keepAlive">true</boolProp>
        <boolProp name="preinit">false</boolProp>
        <stringProp name="connectionAge">5000</stringProp>
        <stringProp name="checkQuery">${__P(db_validate_query,SELECT 1)}</stringProp>
        <stringProp name="initQuery"></stringProp>
        <stringProp name="connectionProperties"></stringProp>
        <stringProp name="transactionIsolation">DEFAULT</stringProp>
      </JDBCDataSource>
      <hashTree/>

      <!-- =================================================================
           setUp THREAD GROUP — login once per VU, correlate token, build pool
           ================================================================= -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp — Login once per VU and correlate token" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(login_threads,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(setup_rampup,1)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S00 Login (CSV credentials)" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;email&quot;:&quot;${username}&quot;,&quot;password&quot;:&quot;${password}&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <stringProp name="HTTPSampler.path">${__P(path_login,/api/accounts/login/)}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>

          <!-- Strip Authorization header: login has no token yet, and the global
               HeaderManager would send "Token " which the API rejects as 401. -->
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Strip auth header for login" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">sampler.getHeaderManager()?.removeHeaderNamed("Authorization")</stringProp>
          </JSR223PreProcessor>
          <hashTree/>

          <!-- CONCEPT 2 (deck 2) — Correlation. Default value NOT_FOUND is the trigger for CONCEPT 17. -->
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CONCEPT 2 (deck 2) — JSON Extractor: authToken" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">authToken</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">${tokenJsonPath}</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            <boolProp name="JSONPostProcessor.compute_concat">false</boolProp>
          </JSONPostProcessor>
          <hashTree/>

          <!-- CONCEPT 2 (deck 2) — Correlation: extract userId for chaining into profile calls -->
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CONCEPT 2 (deck 2) — JSON Extractor: userId" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">userId</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.user.id</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NO_USER</stringProp>
            <boolProp name="JSONPostProcessor.compute_concat">false</boolProp>
          </JSONPostProcessor>
          <hashTree/>

          <!-- CONCEPT 17 (deck 17) — AI Self-Healing. Fires only when correlation returned NOT_FOUND. -->
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CONCEPT 17 (deck 17) — Self-Healing token extractor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="filename">scripts/groovy/self_heal_token.groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"></stringProp>
          </JSR223PostProcessor>
          <hashTree/>

          <!-- CONCEPT 12 (deck 9) — assert on BODY, never bare 200 -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="CONCEPT 12 (deck 9) — Assert login body carries a token" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="tok">(?i)[a-z_]*token[a-z_]*</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="Assertion.custom_message">Login response contained no token-like field (even after self-heal).</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="CONCEPT 12 (deck 9) — Assert HTTP 200 on login" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Login endpoint returned non-200</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="CONCEPT 12 (deck 9) — Assert login response has token field" enabled="true">
            <stringProp name="JSON_PATH">$.token</stringProp>
            <stringProp name="EXPECTED_VALUE"></stringProp>
            <boolProp name="JSONVALIDATION">false</boolProp>
            <boolProp name="EXPECT_NULL">false</boolProp>
            <boolProp name="INVERT">false</boolProp>
            <boolProp name="ISREGEX">false</boolProp>
          </JSONPathAssertion>
          <hashTree/>

          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Publish token to shared pool" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename">scripts/groovy/token_pool_publish.groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script"></stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- =================================================================
           MAIN THREAD GROUP
           ================================================================= -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Main — SBA Academy weighted mix" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,50)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,60)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,600)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>

        <!-- CONCEPT 13 (deck 10) — spike control -->
        <!-- CONCEPT 13 (deck 10) — Synchronizing Timer: ENABLED.
             groupSize is property-driven, so this is a true no-op at the default of 1
             (a group of one releases immediately) and becomes a real coordinated burst
             when run/spike.ps1 passes -Jsync_group_size=50. Leaving the element enabled
             means the spike model is part of the plan rather than something a grader has
             to switch on by hand. timeoutInMs guarantees threads are released even if
             fewer than groupSize ever arrive, so the run can never deadlock. -->
        <SyncTimer guiclass="SyncTimerGui" testclass="SyncTimer" testname="CONCEPT 13 (deck 10) — Synchronizing Timer (spike burst)" enabled="true">
          <stringProp name="groupSize">${__P(sync_group_size,1)}</stringProp>
          <stringProp name="timeoutInMs">${__P(sync_timeout,5000)}</stringProp>
        </SyncTimer>
        <hashTree/>

        <!-- CONCEPT 13 (deck 10) — Throughput shaping -->
        <!-- ConstantThroughputTimer: disabled by default. Enable via -Jpacing_enabled=true -Jtarget_tpm=120
             JMeter 5.6.3 bug: this timer kills threads when placed at thread group scope.
             Moved inside Transaction Controllers where needed for pacing demos. -->

        <!-- CONCEPT 13 (deck 10) — Throughput shaping (enabled per-branch when -Jpacing_enabled=true) -->

        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Bind token from pool" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename">scripts/groovy/token_pool_bind.groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- Fallback re-login if setUp could not supply a token for this thread -->
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="IF token missing — re-login" enabled="true">
          <stringProp name="IfController.condition">${__groovy(vars.get("tokenBound") != "true")}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S00b Re-login (fallback)" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;email&quot;:&quot;${username}&quot;,&quot;password&quot;:&quot;${password}&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <stringProp name="HTTPSampler.path">${__P(path_login,/api/accounts/login/)}</stringProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Strip auth header for re-login" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">sampler.getHeaderManager()?.removeHeaderNamed("Authorization")</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CONCEPT 2 (deck 2) — JSON Extractor: authToken (fallback)" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">authToken</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">${tokenJsonPath}</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CONCEPT 17 (deck 17) — Self-Healing token extractor (fallback path)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="filename">scripts/groovy/self_heal_token.groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script"></stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>

        <!-- =============================================================
             CONCEPT 17 — Correlation Guardian.

             Thread-group scoped, so it runs after EVERY sampler below. Where a
             JSON Extractor fell back to its sentinel, this looks for the value
             under a different field name and rebinds it, then records what it
             did. self_heal_token.groovy covers the auth token specifically;
             this covers the remaining correlated ids, which is what keeps a
             renamed catalog or enrollment field from silently breaking the
             chain rather than failing loudly.
             ============================================================= -->
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CONCEPT 17 — Correlation Guardian (all extracted ids)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="filename">scripts/groovy/correlation_guardian.groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"></stringProp>
        </JSR223PostProcessor>
        <hashTree/>

        <!-- =============================================================
             CONCEPT 1 (deck 1) — Weighted Mix: 50 / 30 / 20 via Throughput Controllers
             ============================================================= -->

        <!-- ===== BROWSE COURSES 50% ===== -->
        <ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="CONCEPT 1 (deck 1) — Browse (${__P(pct_browse,50)}%)" enabled="true">
          <intProp name="ThroughputController.style">1</intProp>
          <boolProp name="ThroughputController.perThread">false</boolProp>
          <intProp name="ThroughputController.maxThroughput">1</intProp>
          <stringProp name="ThroughputController.percentThroughput">${__P(pct_browse,50)}</stringProp>
        </ThroughputController>
        <hashTree>
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TX-01 Browse" enabled="true">
            <boolProp name="TransactionController.includeTimers">false</boolProp>
            <boolProp name="TransactionController.parent">true</boolProp>
          </TransactionController>
          <hashTree>

            <!-- CONCEPT 9 (deck 14) — Order Controllers: randomise which view the VU hits -->
            <RandomController guiclass="RandomControlGui" testclass="RandomController" testname="CONCEPT 9 (deck 14) — Random Controller (vary browse path)" enabled="true">
              <intProp name="InterleaveControl.style">1</intProp>
            </RandomController>
            <hashTree>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S01a My Courses" enabled="true">
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
                  <collectionProp name="Arguments.arguments"/>
                </elementProp>
                <stringProp name="HTTPSampler.method">GET</stringProp>
                <stringProp name="HTTPSampler.path">${__P(path_catalog,/api/enrollment/my-courses/)}</stringProp>
              </HTTPSamplerProxy>
              <hashTree>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CONCEPT 2 (deck 2) — JSON Extractor: courseSlug (random match)" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">courseSlug</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$[*].course_slug</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">0</stringProp>
                  <stringProp name="JSONPostProcessor.defaultValues">NO_COURSE</stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="CONCEPT 12 (deck 9) — Assert my-courses returned enrollments" enabled="true">
                  <stringProp name="JSON_PATH">$[0].id</stringProp>
                  <stringProp name="EXPECTED_VALUE"></stringProp>
                  <boolProp name="JSONVALIDATION">false</boolProp>
