                <hashTree/>
                <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="CONCEPT 12 (deck 9) — Assert first course has id" enabled="true">
                  <stringProp name="JSON_PATH">$.results[0].id</stringProp>
