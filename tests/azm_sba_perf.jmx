              </HTTPSamplerProxy>
              <hashTree>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CONCEPT 2 (deck 2) — JSON Extractor: catalogCourseId" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">catalogCourseId</stringProp>
