            </HTTPSamplerProxy>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CONCEPT 15 (deck 11) — Reset retry state (once per transaction)" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="filename">scripts/groovy/retry_reset_preprocessor.groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
