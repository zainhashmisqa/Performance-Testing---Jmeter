            <!-- CONCEPT 9 (deck 14) — Interleave Controller alternates the entry point per iteration -->
            <InterleaveControl guiclass="InterleaveControlGui" testclass="InterleaveControl" testname="CONCEPT 9 (deck 14) — Interleave Controller (alternate entry)" enabled="true">
              <intProp name="InterleaveControl.style">1</intProp>
